# Required: OpenAI API key with Realtime API access. Never exposed to the browser.
OPENAI_API_KEY=

# --- Frontend (CORS) ---
# Website origins allowed to call the API, comma-separated, no trailing slash.
WEB_ORIGIN=http://localhost:3000
# lax: website and API share one domain (app.example.de + api.example.de).
# none: different domains (needs HTTPS).
COOKIE_SAMESITE=lax

# --- Models ---
# Realtime speech-to-speech:
#   gpt-realtime-2.1-mini  (default, ~1/3 of the price)
#   gpt-realtime-2.1       (best quality)
REALTIME_MODEL=gpt-realtime-2.1-mini
# alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
REALTIME_VOICE=marin
TRANSCRIBE_MODEL=gpt-realtime-whisper
# Text answers for POST /v1/pdf/chat
CHAT_MODEL=gpt-5.4-mini
CHAT_REASONING_EFFORT=low
EMBEDDING_MODEL=text-embedding-3-small

# --- Cost protection (important if the app is public) ---
DAILY_BUDGET_USD=10
MAX_CALL_MINUTES=5
VOICE_MINUTES_PER_IP_PER_DAY=15
MAX_CALLS_PER_IP_PER_DAY=30
MAX_CHATS_PER_IP_PER_DAY=100
MAX_CONCURRENT_CALLS=10

# --- Uploads ---
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=50
MAX_DOCS_PER_VISITOR=3
UPLOADS_PER_IP_PER_DAY=10
DOC_TTL_HOURS=24

# --- Server ---
# API port for `npm run dev` (the web app dev server uses 3000).
# Docker always uses 3000 inside the container.
PORT=4000
# Read the client IP from X-Forwarded-For. Set to true only behind a reverse
# proxy such as nginx or Caddy.
TRUST_PROXY=false
